import os
import click
from weather_app.weather import get_weather, get_forecast, format_weather, format_forecast


def get_api_key(api_key_option):
    """API key — option se ya environment variable se leta hai."""
    key = api_key_option or os.environ.get("OPENWEATHER_API_KEY")
    if not key:
        raise click.ClickException(
            "API key nahi mili!\n"
            "  Option 1: --api-key FLAG use karo\n"
            "  Option 2: Environment variable set karo:\n"
            "             export OPENWEATHER_API_KEY=teri_key"
        )
    return key


@click.group()
@click.version_option(version="1.0.0", prog_name="weather-cli")
def cli():
    """🌤️  Weather CLI — Termux + Python se banaya gaya!

    \b
    Commands:
      now       → Current weather dekho
      forecast  → 5-day forecast dekho
    """
    pass


@cli.command()
@click.argument("city")
@click.option("--api-key", "-k", default=None, help="OpenWeatherMap API key")
def now(city, api_key):
    """Kisi bhi city ka current weather dekho.

    \b
    Example:
      weather-cli now Mumbai
      weather-cli now "New Delhi" --api-key YOUR_KEY
    """
    key = get_api_key(api_key)
    click.echo(f"🔍 Fetching weather for '{city}'...")
    data = get_weather(city, key)
    click.echo(format_weather(data))


@cli.command()
@click.argument("city")
@click.option("--api-key", "-k", default=None, help="OpenWeatherMap API key")
def forecast(city, api_key):
    """Kisi bhi city ka 5-day forecast dekho.

    \b
    Example:
      weather-cli forecast Mumbai
      weather-cli forecast "New Delhi"
    """
    key = get_api_key(api_key)
    click.echo(f"🔍 Fetching 5-day forecast for '{city}'...")
    data = get_forecast(city, key)
    click.echo(format_forecast(data))


if __name__ == "__main__":
    cli()
